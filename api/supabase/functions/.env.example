# Edge Function secrets for support-relay-send.
# Set with: supabase secrets set --env-file supabase/functions/.env.example (after filling in real values)

# Mock mode is the default. Only set to "false" with explicit approval.
TWILIO_MOCK=true

# Only needed when TWILIO_MOCK=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional JSON map of userId -> E.164 relay number. Defaults to two fake test users if unset.
# RELAY_NUMBER_MAP={"<user-a-uuid>":"+15555550101","<user-b-uuid>":"+15555550102"}
