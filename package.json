{
  "name": "mobile-app-template",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint:check": "pnpm exec eslint .",
    "lint:fix": "pnpm exec eslint . --fix",
    "prettier:check": "pnpm exec prettier --check .",
    "prettier:fix": "pnpm exec prettier --write .",
    "typecheck": "pnpm exec tsc --noEmit",
    "prepare": "husky",
    "pre-commit": "(pnpm run typecheck || true) && (pnpm run lint:check || true) && pnpm run prettier:check",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/ui": "~58.0.23",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@rneui/base": "4.0.0-rc.7",
    "@rneui/themed": "4.0.0-rc.8",
    "@supabase/supabase-js": "^2.53.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@eslint/js": "^9.32.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.32.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.3",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "yarnhook": "^0.6.2"
  },
  "private": true
}
